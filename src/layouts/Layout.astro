---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Hemanth Reddy — Software Engineer & Developer Advocate",
	description = "Hemanth Reddy is a software engineer, open source contributor and working on AI evaluations, developer tools and reliable software."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://asp-irin.pages.dev/");
const ogImage = "https://asp-irin.pages.dev/hemanth.jpeg";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Hemanth Reddy" />
		<link rel="canonical" href={canonicalURL} />

		<!-- OpenGraph / Facebook / WhatsApp -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@Hemanth_Asp" />
		<meta name="twitter:creator" content="@Hemanth_Asp" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Hemanth Reddy",
			"url": "https://asp-irin.pages.dev/",
			"jobTitle": "Software Engineer",
			"sameAs": [
				"https://github.com/Asp-irin",
				"https://www.linkedin.com/in/hemanth-kumar-reddy-89668b252/",
				"https://x.com/Hemanth_Asp"
			]
		})} />

		<script is:inline>
			const savedTheme = localStorage.getItem('portfolio-theme');
			document.documentElement.dataset.theme = savedTheme === 'ink' ? 'ink' : 'paper';
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>

:root{
	--main-bg: #FEFFF0;
	--blue: #BAE6FF;
	--yellow: #FFDC58;
	--surface: #FFFFFF;
	--surface-text: #000000;
	--ink: #000000;
	--photo-border: #000000;
	--tool-text: #FFFFFF;
	--shadow: rgba(0,0,0,0.3);
}

:root[data-theme='paper'] {
	--main-bg: #F7F7F4;
	--blue: #DDFE00;
	--yellow: #DDFE00;
	--surface: #FFFFFF;
	--surface-text: #171717;
	--ink: #171717;
	--photo-border: #171717;
	--tool-text: #FFFFFF;
	--shadow: rgba(0,0,0,0.9);
}

:root[data-theme='ink'] {
	--main-bg: #111111;
	--blue: #DDFE00;
	--yellow: #DDFE00;
	--surface: #FFFFFF;
	--surface-text: #111111;
	--ink: #FFFFFF;
	--photo-border: #FFFFFF;
	--tool-text: #111111;
	--shadow: rgba(255,255,255,0.55);
}

html,
body {
	margin: 0;
	width: 100%;
	height: 100%;
	background-color: var(--main-bg);
	color: var(--ink);
	font-family: "Space Grotesk", sans-serif;
	scroll-behavior: smooth;
}

</style>
