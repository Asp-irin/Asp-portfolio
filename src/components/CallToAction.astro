---
import Button from './Button.astro'
import { calendly } from '../sample'

---


<section class="px-3 py-20 md:py-28" id="hire">
    <div class="max-w-3xl mx-auto bg-[var(--surface)] text-[var(--surface-text)] text-center flex flex-col gap-4 border-3 border-[var(--surface-text)] shadow-[8px_8px_0px_var(--shadow)] relative p-10 transition-all duration-200 hover:-translate-y-1 hover:shadow-[12px_12px_0px_var(--shadow)]">
     <h1 class="text-3xl font-bold">Have something to talk?</h1>
     <p class="text-lg max-w-lg mx-auto">Feel free to schedule a time to connect and discuss over projects/ideas.</p>
     <div class="flex justify-center">
       <Button text={calendly.title} link={calendly.link} target="_blank" />
     </div>
    </div>
  </section>