---
import Bars from "./Bars.astro"
import svgUnderline from '../assets/underline.svg'
import arrowCard from '../assets/arrow-card.svg'

const posts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true })) as any[]
---


<section class="py-20 md:py-28 space-y-10 px-5" id="blog">
    <div class="max-w-md mx-auto relative ">
      <h1 class="text-4xl font-medium text-center">Notes &amp; Writing</h1>
      <img src={svgUnderline.src} alt="arrow" width="140" class="theme-arrow absolute left-50 -bottom-1" />
    </div>
  
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10"> 
      {posts.map(({ url, frontmatter }: any) => ( 
        <a href={frontmatter.externalUrl || url} target={frontmatter.externalUrl ? "_blank" : "_self"} class="flex flex-col bg-[var(--surface)] text-[var(--surface-text)] p-5 group relative transition-all duration-200 hover:shadow-[4px_4px_0px_var(--shadow)]">
          <div class="w-full h-[200px] overflow-hidden border-2">
           <img src={frontmatter.image?.url} alt={frontmatter.image?.alt || ''} class="w-full h-full object-cover" />
          </div>
          <div class="space-y-1 pt-4">
            <div class="flex pr-2">
              <h2 class="text-xl font-medium flex-1">{frontmatter.title}</h2>
              <img src={arrowCard.src} alt="arrow" width="25" />
            </div>
            <p class="mr-20">{frontmatter.pubDate}</p>
          </div>
          <Bars />
        </a>
      ))}
    </div>
</section>