---
import { author, buy } from '../sample'
import logoStar from '../assets/logo-star.svg'

const links = [
    { name: 'About', path: '/#about', target: '_self' },
    { name: 'Blogs', path: '/blog', target: '_self' },
    { name: 'Skills', path: '/#skills', target: '_self' },
    { name: 'Experience', path: '/#experience', target: '_self' },
    { name: 'Community', path: '/#talks', target: '_self' },
    { name: 'Playground', path: '/#playground', target: '_self' },
    { name: 'Resume', path: 'https://drive.google.com/file/d/1--5wfomkEXYjhs8WcN1bkMBEW44z3gnl/view?usp=sharing', target: '_blank' },
]

const { pathname } = Astro.url
---

<header class="relative border-b-3 border-[var(--ink)] p-7 overflow-hidden">
    <div class="flex border-3 border-[var(--surface-text)] bg-[var(--surface)] text-[var(--surface-text)] max-w-[310px] md:max-w-4xl m-auto relative z-10">
        <!-- top boxes -->
        <div class="size-2 bg-[var(--surface)] border-2 border-[var(--surface-text)] absolute -top-2 -right-2"></div>
        <div class="size-2 bg-[var(--surface)] border-2 border-[var(--surface-text)] absolute -top-2 -left-2"></div>

        <!-- bottom boxes -->
        <div class="size-2 bg-[var(--surface)] border-2 border-[var(--surface-text)] absolute -bottom-2 -left-2"></div>
        <div class="size-2 bg-[var(--surface)] border-2 border-[var(--surface-text)] absolute -bottom-2 -right-2"></div>
    
        <nav class="flex w-full items-center p-2 md:p-0">
            <div class="flex-1 font-bold whitespace-nowrap">
                <a href="/" class="flex items-center gap-2 pl-3">
                    <img src={logoStar.src} width="22" height="22" alt="star logo" class="theme-art" />
                    <span>Asp-irin</span>
                </a>
            </div>
            <a href="#" class="flex md:hidden" id="menu-open">
                <i class="ri-menu-2-line text-2xl"></i>
            </a>
            <ul class="hidden md:flex shrink-0">
                {links.map(item => ( 
                    <li class="border-l-2 border-[var(--surface-text)] p-3 py-4">
                        <a href={item.path} target={item.target} class="whitespace-nowrap relative flex items-center before:absolute before:left-0 before:bottom-1 before:h-[8px] before:w-0 before:bg-[var(--yellow)] before:transition-all before:duration-300 hover:before:w-full">
                            <span class="relative z-5">{item.name} {pathname == item.path ? '//' : ''}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
  </header>

    <div class="block md:hidden fixed left-0 top-0 h-full w-full bg-[var(--main-bg)] text-[var(--ink)] z-20 p-3 transition-all duration-300 -translate-x-[100%]" id="menu-content">
    <div class="flex p-6">
        <h3 class="flex-1 font-bold uppercase">Menu</h3>
        <a href="#" id="menu-close">               
           <i class="ri-close-line text-3xl"></i>
        </a>
    </div>
    <ul class="flex flex-col justify-center items-center gap-4 md:hidden">
        {links.map(item => ( 
            <li class="py-3">
                <a href={item.path} target={item.target} class="p-3 whitespace-nowrap text-2xl font-bold">
                    {item.name} {pathname == item.path ? '//' : ''}
                </a>
            </li>
        ))}
    </ul>
  </div>

    <div class="theme-switcher" aria-label="Color theme">
        <button type="button" data-theme-option="paper" aria-label="Use white theme">W</button>
        <button type="button" data-theme-option="ink" aria-label="Use black theme">B</button>
    </div>


<script>
document.addEventListener('DOMContentLoaded', function () {
    const menuContent = document.querySelector('#menu-content') 
    const menuOpen = document.querySelector('#menu-open') 
    const menuClose = document.querySelector('#menu-close') 


    menuOpen?.addEventListener('click', (e) => {
        e.preventDefault()
        menuContent?.classList.remove('-translate-x-[100%]')
    })

    menuClose?.addEventListener('click', (e) => {
        e.preventDefault()
        menuContent?.classList.add('-translate-x-[100%]')
    })


    menuContent?.querySelectorAll('li a').forEach(item => {
        item.addEventListener('click', (e) => {
            menuContent?.classList.add('-translate-x-[100%]')
        })
    })

        const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]')
        const setTheme = (theme: string) => {
            const selectedTheme = theme === 'ink' ? 'ink' : 'paper'
            document.documentElement.dataset.theme = selectedTheme
            localStorage.setItem('portfolio-theme', selectedTheme)
            themeButtons.forEach(button => button.toggleAttribute('aria-pressed', button.dataset.themeOption === selectedTheme))
        }

        setTheme(localStorage.getItem('portfolio-theme') || document.documentElement.dataset.theme || 'paper')
        themeButtons.forEach(button => button.addEventListener('click', () => setTheme(button.dataset.themeOption || 'paper')))
})
</script>

<style>
    .theme-switcher {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 30;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem;
        border: 2px solid var(--ink);
        background: var(--surface);
        color: var(--surface-text);
        box-shadow: 4px 4px 0 var(--shadow);
        font-size: 0.7rem;
        font-weight: 700;
    }

    .theme-switcher button {
        width: 1.7rem;
        height: 1.7rem;
        padding: 0;
        border: 1px solid var(--surface-text);
        color: #111;
        cursor: pointer;
    }
    .theme-switcher button[data-theme-option="paper"] { background: #fff; }
    .theme-switcher button[data-theme-option="ink"] { background: #111; color: #fff; }
    .theme-switcher button[aria-pressed="true"],
    :root[data-theme="paper"] .theme-switcher button[data-theme-option="paper"],
    :root[data-theme="ink"] .theme-switcher button[data-theme-option="ink"] {
        outline: 2px solid var(--yellow);
        outline-offset: 2px;
        box-shadow: 0 0 0 1px var(--ink);
    }
</style>