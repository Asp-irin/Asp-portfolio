---
const { text, link, target } = Astro.props

import svgHl from '../assets/hl.svg'
---

<div class="relative group">
   <a href={link} target={target} class="bg-[var(--blue)] text-[var(--surface-text)] text-md font-medium flex items-center h-12 px-6 border-3 border-[var(--surface-text)] rounded-full transition-all duration-200 group-hover:-translate-y-0.5 group-hover:shadow-[4px_4px_0px_var(--shadow)]">{text}</a>
   <img src={svgHl.src} width="30" alt="" class="theme-hl absolute -right-7 -bottom-3 transition-all duration-200 group-hover:-bottom-4 group-hover:-right-8" />
</div>